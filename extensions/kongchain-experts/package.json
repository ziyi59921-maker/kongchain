{
  "name": "@kongchain/experts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KongChain finance expert catalog, planning, dispatch over Harness subagents, real status logging, and expert-center UI.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "kongchain",
    "experts",
    "subagent"
  ]
}
