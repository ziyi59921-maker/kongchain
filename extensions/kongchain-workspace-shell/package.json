{
  "name": "@kongchain/workspace-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KongChain desktop work platform shell: left navigation, workbench dashboard, file workspace, task board, and capability center.",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "client.js", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": ["dsh-plugin", "kongchain", "workspace", "desktop"]
}
